OPENAI_API_KEY=
# Optional; defaults to text-embedding-3-small (1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone — create a serverless index with dimension 1536 and cosine metric
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional: isolate vectors inside the index
PINECONE_NAMESPACE=

# POST /ingest chunking (defaults: 800 / 100)
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=100

# POST /ask retrieval (default 5)
ASK_TOP_K=5
